{
  "permissions": {
    "deny": [
      "Bash(aws *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(*prisma migrate*)",
      "Bash(*prisma:migrate*)",
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)"
    ]
  }
}
