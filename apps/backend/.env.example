PORT=3000
FRONTEND_URL=http://localhost:3001

# local | iam  (default: local)
DATABASE_AUTH_MODE=local

# Local password authentication (required when DATABASE_AUTH_MODE=local)
# Also used by Prisma CLI (generate / migrate)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shop_delivery

# AWS IAM database authentication (required when DATABASE_AUTH_MODE=iam)
# Credentials come from the EC2 instance role — do not put IAM tokens or AWS keys here.
AWS_REGION=us-east-1
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=shop_delivery
DATABASE_USER=shop_delivery_app

# Optional: path to Amazon RDS CA bundle PEM for full TLS certificate verification.
# Without this, IAM mode uses TLS encryption equivalent to sslmode=require.
# DATABASE_SSL_CA_PATH=/path/to/global-bundle.pem

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
